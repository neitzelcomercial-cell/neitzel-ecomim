{
  "manifest_version": 3,
  "name": "Cacador de Contatos ECOMIM",
  "version": "1.0.0",
  "description": "Le os contatos das abas abertas pelas buscas do Cacador de Leads e envia organizados para o LeadsCRM.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cacador de Contatos ECOMIM"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["crm_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
